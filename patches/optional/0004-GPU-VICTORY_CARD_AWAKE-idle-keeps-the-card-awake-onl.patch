 "#;
 
+/// As [`COUNT`], about a quarter of a millisecond (`VICTORY_CARD_AWAKE=idle`):
+/// what stands in the way of a submission sent meanwhile.
+const COUNT_SHORT: &str = r#"
+#define RS "UAV(u0)"
+RWByteAddressBuffer sum : register(u0);
+[RootSignature(RS)]
+[numthreads(64, 1, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    uint x = id.x;
+    [loop] for (uint i = 0; i < 50000u; i++) x = x * 1664525u + 1013904223u;
+    sum.Store(id.x * 4u, x);
+}
+"#;
+
+/// Whether the drawing queue has run everything of ours sent to it (the card
+/// clock's idle stretch, `Host::card_sent` and its watching thread).
+static IDLE: AtomicBool = AtomicBool::new(false);
+
+/// The card clock: the drawing queue ran all that was sent (`true`), or lists
+/// were just sent (`false`).
+pub(super) fn card_idle(idle: bool) {
+    IDLE.store(idle, Ordering::Relaxed);
+}
+
 /// Quiet this long after the last submission.
 const QUIET_MS: u64 = 250;
 
